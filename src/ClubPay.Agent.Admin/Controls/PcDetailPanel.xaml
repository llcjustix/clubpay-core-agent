<UserControl x:Class="ClubPay.Agent.Admin.Controls.PcDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClubPay.Agent.Admin.ViewModels"
             Width="580">

  <!-- Panel bound to AdminViewModel -->
  <Border BorderThickness="1,0,0,0" BorderBrush="#3800D4FF">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF16131F" Offset="0"/>
        <GradientStop Color="#FF0C0F16" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Direction="180" BlurRadius="90" ShadowDepth="0" Opacity="0.6" Color="Black"/>
    </Border.Effect>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,26,28,28">
      <StackPanel>

        <!-- PC ID + zone + close -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedPc.PcId}" Foreground="White"
                       FontFamily="{StaticResource FontChakra}" FontSize="36" FontWeight="Bold"
                       Margin="0,0,12,0"/>
            <Border CornerRadius="999" Padding="16,6" VerticalAlignment="Center"
                    Background="#1A00D4FF" BorderBrush="#3300D4FF" BorderThickness="1">
              <TextBlock Text="{Binding SelectedPc.ZoneLabel}"
                         Foreground="{StaticResource CyanSoftBrush}"
                         FontFamily="{StaticResource FontMono}" FontSize="14" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10"
                  Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                  Cursor="Hand" MouseLeftButtonUp="OnClose" VerticalAlignment="Top">
            <TextBlock Text="✕" Foreground="{StaticResource TextSecondary}"
                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>

        <!-- Countdown (mock: 00:45:12 active) -->
        <Border Margin="0,14,0,0" CornerRadius="18" BorderThickness="1"
                Background="#0A00FF88" BorderBrush="#4700FF88" Padding="16,16">
          <StackPanel>
            <TextBlock Text="FAOL SESSIYA · ACTIVE SESSION" HorizontalAlignment="Center"
                       Foreground="#FF9FB0A6" FontFamily="{StaticResource FontMono}"
                       FontSize="13"/>
            <TextBlock Text="00:45:12" HorizontalAlignment="Center"
                       Foreground="{StaticResource GreenBrush}"
                       FontFamily="{StaticResource FontMono}" FontSize="58" FontWeight="Bold"
                       Margin="0,4,0,0">
              <TextBlock.Effect>
                <DropShadowEffect Color="#FF00FF88" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
              </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="qolgan vaqt · remaining · осталось" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource FontMono}" FontSize="13"/>
          </StackPanel>
        </Border>

        <!-- Session info grid -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource InfoTile}">
            <StackPanel>
              <TextBlock Text="Tarif" Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="12"/>
              <TextBlock Text="Pro — 2 soat" Foreground="White"
                         FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource InfoTile}">
            <StackPanel>
              <TextBlock Text="Boshlandi" Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="14"/>
              <TextBlock Text="20:15" Foreground="White"
                         FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource InfoTile}">
            <StackPanel>
              <TextBlock Text="To'langan" Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="14"/>
              <TextBlock Text="35 000 so'm" Foreground="{StaticResource GreenBrush}"
                         FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource InfoTile}">
            <StackPanel>
              <TextBlock Text="To'lov usuli" Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="14"/>
              <TextBlock Text="Click · online" Foreground="White"
                         FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Action buttons -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Sessiya boshlash -->
          <Border Grid.Column="0" Grid.Row="0" CornerRadius="13" Padding="11,11" Cursor="Hand"
                  BorderThickness="1" BorderBrush="#66FFFFFF">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#2D00FF88" Offset="0"/>
                <GradientStop Color="#1400FF88" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <TextBlock Text="Sessiya boshlash" Foreground="{StaticResource GreenSoftBrush}"
                         FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="tarif ▾" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="12"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Uzaytirish -->
          <Border Grid.Column="2" Grid.Row="0" CornerRadius="13" Padding="11,11" Cursor="Hand"
                  BorderThickness="1" BorderBrush="#5500D4FF">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#2900D4FF" Offset="0"/>
                <GradientStop Color="#1200D4FF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <TextBlock Text="Uzaytirish" Foreground="{StaticResource CyanSoftBrush}"
                         FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="muddat ▾" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="12"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Sessiyani tugatish -->
          <Border Grid.Column="0" Grid.Row="2" CornerRadius="13" Padding="11,11" Cursor="Hand"
                  Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <TextBlock Text="Sessiyani tugatish" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="SemiBold"/>
          </Border>

          <!-- Yoqish / Uxlatish -->
          <Border Grid.Column="2" Grid.Row="2" CornerRadius="13" Padding="11,11" Cursor="Hand"
                  Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <TextBlock Text="Yoqish / Uxlatish" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="SemiBold"/>
          </Border>

          <!-- Xabar yuborish -->
          <Border Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" CornerRadius="13"
                  Padding="15,15" Cursor="Hand"
                  Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <TextBlock Text="Ekranga xabar yuborish" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="SemiBold"/>
          </Border>

          <!-- Naqd to'lov -->
          <Border Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="3" CornerRadius="13"
                  Padding="15,15" Cursor="Hand"
                  Background="#1FFF3B5C" BorderBrush="#72FF3B5C" BorderThickness="1"
                  MouseLeftButtonUp="OnCashPaymentClick">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="Naqd to'lov" Foreground="{StaticResource RedSoftBrush}"
                         FontFamily="{StaticResource FontChakra}" FontSize="19" FontWeight="Bold"
                         Margin="0,0,12,0"/>
              <TextBlock Text="— so'nggi chora" Foreground="#FFC98594"
                         FontFamily="{StaticResource FontMono}" FontSize="14"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Today's sessions -->
        <TextBlock Text="BUGUNGI SESSIYALAR · TODAY" Margin="0,20,0,10"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontMono}" FontSize="15"/>

        <ItemsControl>
          <ItemsControl.Items>
            <Border CornerRadius="9" Background="#07FFFFFF" Padding="11,14" Margin="0,0,0,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="20:15 → …" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="15" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="Pro · 2 soat" Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource FontChakra}" FontSize="16" FontWeight="Medium"/>
                <TextBlock Grid.Column="2" Text="35 000" Foreground="{StaticResource GreenBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="16" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="3" Text="Click" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="15"/>
              </Grid>
            </Border>
            <Border CornerRadius="9" Background="#07FFFFFF" Padding="11,14" Margin="0,0,0,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="17:40 → 19:40" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="15" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="Pro · 2 soat" Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource FontChakra}" FontSize="16" FontWeight="Medium"/>
                <TextBlock Grid.Column="2" Text="28 000" Foreground="{StaticResource GreenBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="16" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="3" Text="Payme" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="15"/>
              </Grid>
            </Border>
            <Border CornerRadius="9" Background="#07FFFFFF" Padding="11,14" Margin="0,0,0,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="12:30 → 15:00" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="15" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="Pro · 3 soat" Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource FontChakra}" FontSize="16" FontWeight="Medium"/>
                <TextBlock Grid.Column="2" Text="39 000" Foreground="{StaticResource GreenBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="16" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="3" Text="Naqd" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="15"/>
              </Grid>
            </Border>
          </ItemsControl.Items>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
