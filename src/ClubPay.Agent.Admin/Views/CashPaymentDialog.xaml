<UserControl x:Class="ClubPay.Agent.Admin.Views.CashPaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Admin.Converters"
             Width="780">

  <Border CornerRadius="22" BorderThickness="1" BorderBrush="#52FF962A" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF17141F" Offset="0"/>
        <GradientStop Color="#FF0D1117" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="130" ShadowDepth="0" Opacity="0.7" Color="Black"/>
    </Border.Effect>

    <StackPanel>
      <!-- WARNING BANNER -->
      <Border Padding="32,22" BorderThickness="0,0,0,1" BorderBrush="#4DFF9628">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3DFF781E" Offset="0"/>
            <GradientStop Color="#2EFF3B5C" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel Orientation="Horizontal">
          <Border Width="48" Height="48" CornerRadius="12"
                  Background="#38FF9628" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="!" Foreground="#FFFFB070"
                       FontFamily="{StaticResource FontChakra}" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Avval onlayn to'lovni taklif qiling!"
                       Foreground="#FFFFB070"
                       FontFamily="{StaticResource FontChakra}" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Naqd to'lov faqat so'nggi chora · Offer online payment first"
                       Foreground="#FFCAA489"
                       FontFamily="{StaticResource FontMono}" FontSize="15" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- FORM -->
      <StackPanel Margin="36,30,36,34">
        <TextBlock FontFamily="{StaticResource FontChakra}" FontSize="28" FontWeight="Bold">
          <Run Text="Naqd to'lov " Foreground="White"/>
          <Run Text="· Cash payment" Foreground="{StaticResource TextMuted}" FontSize="20" FontWeight="Medium"/>
        </TextBlock>

        <!-- PC + Zone / Tariff row -->
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="PC" Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,0,0,7"/>
            <Border CornerRadius="12" Background="#07FFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="18,14">
              <Grid>
                <TextBlock Text="{Binding SelectedPc.PcId}" Foreground="White"
                           FontFamily="{StaticResource FontChakra}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedPc.ZoneLabel}" HorizontalAlignment="Right"
                           Foreground="{StaticResource CyanSoftBrush}"
                           FontFamily="{StaticResource FontMono}" FontSize="15"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Tarif" Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,0,0,7"/>
            <Border CornerRadius="12" Background="#07FFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="18,14">
              <Grid>
                <TextBlock Text="2 soat" Foreground="White"
                           FontFamily="{StaticResource FontChakra}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="▾" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"
                           FontSize="16" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Amount -->
        <StackPanel Margin="0,16,0,0">
          <TextBlock Text="Summa · auto-hisoblangan" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,0,0,7"/>
          <Border CornerRadius="12" Background="#0A00D4FF"
                  BorderBrush="#4700D4FF" BorderThickness="1" Padding="20,16">
            <Grid>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="28 000 " Foreground="{StaticResource CyanSoftBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="34" FontWeight="Bold"/>
                <TextBlock Text="so'm" Foreground="#FF9FE6FF"
                           FontFamily="{StaticResource FontChakra}" FontSize="20" FontWeight="Medium"
                           VerticalAlignment="Bottom" Margin="0,0,0,6"/>
              </StackPanel>
              <TextBlock Text="2 soat × Pro tarif" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextMuted}"
                         FontFamily="{StaticResource FontMono}" FontSize="14"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Reason codes -->
        <StackPanel Margin="0,16,0,0">
          <TextBlock Text="Sabab kodi · Reason" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,0,0,7"/>
          <StackPanel Orientation="Horizontal">
            <Border CornerRadius="11" Padding="0,13" Width="175" Margin="0,0,10,0" Cursor="Hand"
                    Background="#28FF9628" BorderBrush="#80FF9628" BorderThickness="1">
              <TextBlock Text="Internet yo'q" HorizontalAlignment="Center"
                         Foreground="{StaticResource OrangeBrush}"
                         FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="SemiBold"/>
            </Border>
            <Border CornerRadius="11" Padding="0,13" Width="175" Margin="0,0,10,0" Cursor="Hand"
                    Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
              <TextBlock Text="Mijoz iltimosi" HorizontalAlignment="Center"
                         Foreground="{StaticResource TextSecondary}"
                         FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="Medium"/>
            </Border>
            <Border CornerRadius="11" Padding="0,13" Width="175" Cursor="Hand"
                    Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
              <TextBlock Text="Boshqa" HorizontalAlignment="Center"
                         Foreground="{StaticResource TextSecondary}"
                         FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="Medium"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Admin PIN -->
        <StackPanel Margin="0,16,0,0">
          <TextBlock Text="Admin PIN" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,0,0,7"/>
          <Border CornerRadius="12" Background="#07FFFFFF"
                  BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,0" Height="80">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="● ● ● ●" Foreground="{StaticResource TextSecondary}"
                         FontFamily="{StaticResource FontMono}" FontSize="30" FontWeight="Bold"/>
              <Rectangle x:Name="PinCaret" Width="3" Height="32" Fill="{StaticResource OrangeBrush}"
                          Margin="14,0,0,0" VerticalAlignment="Center">
                <Rectangle.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1" To="0" Duration="0:0:0.55" AutoReverse="True"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Rectangle.Triggers>
              </Rectangle>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Confirm button -->
        <Border Margin="0,20,0,0" CornerRadius="14" Height="60" Cursor="Hand"
                MouseLeftButtonUp="OnConfirm">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FFFF7A1E" Offset="0"/>
              <GradientStop Color="#FFFF5A3C" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.Effect>
            <DropShadowEffect Color="#FFFF781E" BlurRadius="34" ShadowDepth="0" Opacity="0.3"/>
          </Border.Effect>
          <TextBlock Text="Tasdiqlash · Confirm" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="#FF1F0D04"
                     FontFamily="{StaticResource FontChakra}" FontSize="23" FontWeight="Bold"/>
        </Border>

        <!-- Cancel -->
        <TextBlock Text="Bekor qilish · Cancel" HorizontalAlignment="Center"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontChakra}" FontSize="17"
                   Cursor="Hand" Margin="0,14,0,0"
                   MouseLeftButtonUp="OnCancel"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
