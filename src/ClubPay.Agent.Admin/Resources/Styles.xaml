<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:ClubPay.Agent.Admin.Converters">

  <!-- Fonts -->
  <FontFamily x:Key="FontChakra">Chakra Petch, Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>

  <!-- Palette -->
  <SolidColorBrush x:Key="BgDark"        Color="#FF0D1117"/>
  <SolidColorBrush x:Key="BgCard"        Color="#FF1A1A2E"/>
  <SolidColorBrush x:Key="CyanBrush"     Color="#FF00D4FF"/>
  <SolidColorBrush x:Key="GreenBrush"    Color="#FF00FF88"/>
  <SolidColorBrush x:Key="RedBrush"      Color="#FFFF3B5C"/>
  <SolidColorBrush x:Key="YellowBrush"   Color="#FFFFD60A"/>
  <SolidColorBrush x:Key="OrangeBrush"   Color="#FFFF9B3C"/>
  <SolidColorBrush x:Key="TextPrimary"   Color="#FFC7CCD6"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#FFAEB6C2"/>
  <SolidColorBrush x:Key="TextMuted"     Color="#FF7F8694"/>
  <SolidColorBrush x:Key="TextDimmed"    Color="#FF6F7787"/>
  <SolidColorBrush x:Key="RedSoftBrush"   Color="#FFFF8094"/>
  <SolidColorBrush x:Key="CyanSoftBrush"  Color="#FF37DFFF"/>
  <SolidColorBrush x:Key="GreenSoftBrush" Color="#FFBDF5D8"/>

  <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF0C1020" Offset="0"/>
    <GradientStop Color="#FF15142A" Offset="0.6"/>
    <GradientStop Color="#FF0D1117" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF00D4FF" Offset="0"/>
    <GradientStop Color="#FF00FF88" Offset="1"/>
  </LinearGradientBrush>

  <!-- Converters -->
  <cv:BoolToVisibilityConverter    x:Key="BoolVis"/>
  <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
  <cv:PcStatusToBrushConverter     x:Key="StatusBrush"/>
  <cv:PcStatusToTextConverter      x:Key="StatusText"/>
  <cv:TiyinToSomConverter          x:Key="TiyinSom"/>

  <!-- Zone tab button -->
  <Style x:Key="ZoneTab" TargetType="Border">
    <Setter Property="CornerRadius"    Value="10"/>
    <Setter Property="Background"      Value="#0DFFFFFF"/>
    <Setter Property="BorderBrush"     Value="#1AFFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="24,9"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style x:Key="ZoneTabActive" TargetType="Border" BasedOn="{StaticResource ZoneTab}">
    <Setter Property="Background" Value="{StaticResource CyanBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
  </Style>

  <!-- Action mini-button -->
  <Style x:Key="MiniBtn" TargetType="Border">
    <Setter Property="CornerRadius"    Value="9"/>
    <Setter Property="Background"      Value="#0DFFFFFF"/>
    <Setter Property="BorderBrush"     Value="#1AFFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>

  <!-- Info tile -->
  <Style x:Key="InfoTile" TargetType="Border">
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background"   Value="#07FFFFFF"/>
    <Setter Property="Padding"      Value="14,16"/>
  </Style>

</ResourceDictionary>
