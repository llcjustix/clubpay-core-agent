<Window x:Class="ClubPay.Agent.Client.Views.GameLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
        WindowStyle="None" WindowState="Normal" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Loaded="OnLoaded"
        Background="{StaticResource BgDark}">

  <Window.Resources>
    <cv:BoolToVisibilityConverter         x:Key="BoolVis"/>
    <cv:InverseBoolToVisibilityConverter  x:Key="InvBoolVis"/>
  </Window.Resources>

  <Grid>
    <!-- Subtle grid overlay -->
    <Grid.Background>
      <DrawingBrush TileMode="Tile" Viewport="0,0,47,47" ViewportUnits="Absolute" Opacity="0.018">
        <DrawingBrush.Drawing>
          <GeometryDrawing>
            <GeometryDrawing.Pen><Pen Brush="White" Thickness="0.5"/></GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <LineGeometry StartPoint="47,0" EndPoint="47,47"/>
                <LineGeometry StartPoint="0,47" EndPoint="47,47"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </Grid.Background>

    <DockPanel>

      <!-- ── TOP BAR ─────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Top" Background="#0D000000" Padding="32,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Logo + club + pc -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M17,0 L34,9.5 L34,28.5 L17,38 L0,28.5 L0,9.5 Z"
                  Width="26" Height="26" Stretch="Uniform" Margin="0,0,12,0">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF00D4FF" Offset="0"/>
                  <GradientStop Color="#FF00FF88" Offset="1"/>
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <TextBlock Text="{Binding ClubName}" FontFamily="{StaticResource FontChakra}"
                       FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text=" · " Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource FontMono}" FontSize="15" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PcId}" FontFamily="{StaticResource FontMono}"
                       FontSize="15" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Running app indicator -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding IsAppRunning, Converter={StaticResource BoolVis}}">
            <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0">
              <Ellipse.Effect>
                <DropShadowEffect Color="#FF00FF88" BlurRadius="8" ShadowDepth="0"/>
              </Ellipse.Effect>
            </Ellipse>
            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="14"
                       Foreground="{StaticResource GreenBrush}">
              <Run Text="{Binding RunningApp.Name, Mode=OneWay}"/>
              <Run Text=" ishlamoqda" Foreground="{StaticResource TextMuted}"/>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── PLAYER APP DOCK ───────────────────────────────────────
           Safe replacement for the Windows taskbar. It exposes only apps which
           ClubPay itself started, so a player can minimise and restore Steam or a
           browser without being able to reach Explorer or system settings. -->
      <Border DockPanel.Dock="Bottom" Background="#EE111827"
              BorderBrush="#2B00D4FF" BorderThickness="0,1,0,0"
              Padding="18,8" MinHeight="64">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Launcher button deliberately returns to the Agent UI without closing apps. -->
          <Button Grid.Column="0" Width="42" Height="42" Cursor="Hand"
                  ToolTip="ClubPay launcher" Command="{Binding ShowLauncherCommand}"
                  Background="#1C00D4FF" BorderBrush="#4000D4FF" BorderThickness="1">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                  <Path Data="M17,0 L34,9.5 L34,28.5 L17,38 L0,28.5 L0,9.5 Z"
                        Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Fill="{StaticResource CyanBrush}"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <Border Grid.Column="1" Width="1" Height="30" Margin="14,0"
                  Background="#26FFFFFF" VerticalAlignment="Center"/>

          <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding RunningApps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,8,0" Height="42" MinWidth="132" MaxWidth="240"
                          Cursor="Hand" ToolTip="Открыть приложение"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                          Command="{Binding DataContext.FocusRunningAppCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <Button.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Закрыть приложение"
                                  Command="{Binding CloseRunningAppCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="DockItem" Padding="10,5" CornerRadius="7"
                                Background="#16FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="6" Background="#1800D4FF"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding FirstChar}" FontFamily="{StaticResource FontChakra}"
                                         FontSize="14" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontChakra}"
                                         FontSize="12" FontWeight="SemiBold" Foreground="White"
                                         TextTrimming="CharacterEllipsis"/>
                              <Border Height="2" Background="{StaticResource CyanBrush}" CornerRadius="1" Margin="0,3,0,0"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DockItem" Property="Background" Value="#2800D4FF"/>
                            <Setter TargetName="DockItem" Property="BorderBrush" Value="#8000D4FF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Column="3" Text="Открытые приложения" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontMono}" FontSize="11"
                     Foreground="{StaticResource TextMuted}" Margin="12,0,0,0"
                     Visibility="{Binding IsAppRunning, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Border>

      <!-- ── CONTENT ────────────────────────────────────────────── -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="40,28">
        <StackPanel>

          <!-- Section label -->
          <TextBlock Text="O'YINLAR VA DASTURLAR"
                     FontFamily="{StaticResource FontMono}" FontSize="11"
                     Foreground="{StaticResource TextMuted}" Margin="0,0,0,24"/>

          <!-- Kept visible only when populated; a launch failure must never look like a dead tile. -->
          <TextBlock Text="{Binding LaunchError}"
                     FontFamily="{StaticResource FontChakra}" FontSize="14"
                     Foreground="#FFFF5A6F" TextWrapping="Wrap" Margin="0,0,0,16"/>

          <!-- Tiles -->
          <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="200" Height="170" Margin="0,0,16,16"
                        CornerRadius="16" Cursor="Hand"
                        BorderThickness="1">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                  </Border.Effect>
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                      Command="{Binding DataContext.LaunchAppCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"/>
                  </Border.InputBindings>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background"   Value="#0DFFFFFF"/>
                      <Setter Property="BorderBrush"  Value="#18FFFFFF"/>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background"  Value="#1AFFFFFF"/>
                          <Setter Property="BorderBrush" Value="#3300D4FF"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                    <!-- First letter icon -->
                    <Border Width="68" Height="68" CornerRadius="14"
                            Background="#1400D4FF" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding FirstChar}"
                                 FontFamily="{StaticResource FontChakra}"
                                 FontSize="34" FontWeight="Bold"
                                 Foreground="{StaticResource CyanBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{StaticResource FontChakra}"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"
                               TextAlignment="Center" Margin="0,12,0,2"
                               TextWrapping="Wrap" MaxWidth="160"/>
                    <TextBlock Text="{Binding Category}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
