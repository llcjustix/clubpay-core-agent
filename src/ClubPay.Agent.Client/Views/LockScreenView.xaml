<UserControl x:Class="ClubPay.Agent.Client.Views.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClubPay.Agent.Client.ViewModels"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Background="{StaticResource BgGradient}">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>

  <Viewbox Stretch="Uniform">
  <Grid Width="1920" Height="1080">
    <!-- Grid line overlay -->
    <Rectangle Opacity="0.018">
      <Rectangle.Fill>
        <DrawingBrush TileMode="Tile" Viewport="0,0,47,47" ViewportUnits="Absolute">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing>
                <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                  <GeometryGroup>
                    <LineGeometry StartPoint="47,0" EndPoint="47,47"/>
                    <LineGeometry StartPoint="0,47" EndPoint="47,47"/>
                  </GeometryGroup>
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Vignette -->
    <Rectangle Fill="{StaticResource Vignette}"/>

    <!-- TOP BAR -->
    <Grid Margin="64,46,64,0" VerticalAlignment="Top" Height="62">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Club name -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding ClubName}" Foreground="White"
                     FontFamily="{StaticResource FontChakra}" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[GamingClub], Mode=OneWay}" Foreground="{StaticResource CyanBrush}"
                     FontFamily="{StaticResource FontMono}" FontSize="15"/>
        </StackPanel>
      </StackPanel>

      <!-- Language, time + lock badge -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox Style="{StaticResource LanguagePicker}" Margin="0,0,18,0"
                  SelectedValue="{Binding Source={StaticResource Loc}, Path=LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag" VerticalContentAlignment="Center">
          <ComboBoxItem Content="RU" Tag="ru"/>
          <ComboBoxItem Content="UZ" Tag="uz"/>
        </ComboBox>
        <TextBlock Text="{Binding CurrentTime}" Foreground="{StaticResource TextSecondary}"
                   FontFamily="{StaticResource FontMono}" FontSize="26" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Border CornerRadius="8" BorderThickness="1" Padding="16,9"
                Background="#19FF3B5C" BorderBrush="#66FF3B5C" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="{StaticResource RedBrush}" Margin="0,0,10,0">
              <Ellipse.Effect>
                <DropShadowEffect Color="#FFFF3B5C" BlurRadius="12" ShadowDepth="0"/>
              </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Locked], Mode=OneWay}" Foreground="{StaticResource RedSoftBrush}"
                       FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- CENTER CONTENT -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">

      <Border CornerRadius="8" BorderThickness="1" Padding="20,8"
              Background="#14FFFFFF" BorderBrush="#5900D4FF"
              HorizontalAlignment="Center" Margin="0,0,0,14">
        <TextBlock Text="{Binding ZoneLabel}" Foreground="#FFCFE9F5"
                   FontFamily="{StaticResource FontChakra}" FontSize="22" FontWeight="Medium"/>
      </Border>

      <!-- PC identity -->
      <TextBlock Text="{Binding PcId}" HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontChakra}" FontSize="100" FontWeight="Bold">
        <TextBlock.Foreground>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White"     Offset="0"/>
            <GradientStop Color="#FF9FB4C9" Offset="1"/>
          </LinearGradientBrush>
        </TextBlock.Foreground>
      </TextBlock>

      <!-- Standard static payment QR. It disappears while this PC is held for a reservation. -->
      <StackPanel Margin="0,38,0,0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsReserved}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Border CornerRadius="20" Background="White" Padding="22" HorizontalAlignment="Center">
          <Image Source="{Binding PayQrImage}" Width="300" Height="300" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ScanToPay], Mode=OneWay}" HorizontalAlignment="Center" Margin="0,18,0,0"
                   Foreground="{StaticResource GreenBrush}" FontFamily="{StaticResource FontChakra}" FontSize="26" FontWeight="SemiBold"/>
      </StackPanel>

      <!-- Reservation replaces the payment QR during the protected window. -->
      <Border CornerRadius="20" Padding="42,30" Margin="0,38,0,0" Background="#1A23B05D" BorderBrush="#AA00E676" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsReserved}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="ПК ЗАБРОНИРОВАН" HorizontalAlignment="Center" Foreground="{StaticResource GreenBrush}" FontFamily="{StaticResource FontChakra}" FontSize="34" FontWeight="Bold"/>
          <TextBlock Text="Ваша бронь начинается в" HorizontalAlignment="Center" Margin="0,20,0,0" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource FontChakra}" FontSize="22"/>
          <TextBlock Text="{Binding ReservationStart}" HorizontalAlignment="Center" Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="54" FontWeight="Bold"/>
          <TextBlock Text="Код для начала игры" HorizontalAlignment="Center" Margin="0,20,0,0" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource FontChakra}" FontSize="22"/>
          <TextBlock Text="{Binding ReservationCode}" HorizontalAlignment="Center" Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="72" FontWeight="Bold"/>
          <TextBlock Text="Введите код до" HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource FontChakra}" FontSize="20"/>
          <TextBlock Text="{Binding ArrivalDeadline}" HorizontalAlignment="Center" Foreground="{StaticResource GreenBrush}" FontFamily="{StaticResource FontMono}" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Если не начать игру в течение 15 минут после начала, бронь отменится и ПК снова станет свободным." TextAlignment="Center" TextWrapping="Wrap" Width="650" HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource FontChakra}" FontSize="18"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- WIFI CORNER (bottom-left) -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                HorizontalAlignment="Left" Margin="64,0,0,44">
      <Border CornerRadius="12" Background="White" Padding="10">
        <Image Source="{Binding WifiQrImage}" Width="108" Height="108"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="320">
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[NoInternet], Mode=OneWay}"
                   Foreground="{StaticResource TextSecondary}"
                   FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[WifiHelp], Mode=OneWay}"
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                   FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,3,0,0"/>
      </StackPanel>
    </StackPanel>

  </Grid>
  </Viewbox>
</UserControl>
