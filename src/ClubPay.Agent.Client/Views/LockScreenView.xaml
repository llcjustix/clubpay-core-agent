<UserControl x:Class="ClubPay.Agent.Client.Views.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClubPay.Agent.Client.ViewModels"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Background="{StaticResource BgGradient}"
             KeyDown="OnKeyDown" Focusable="True">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>

  <Grid>
    <!-- Grid line overlay -->
    <Rectangle Opacity="0.018">
      <Rectangle.Fill>
        <DrawingBrush TileMode="Tile" Viewport="0,0,47,47" ViewportUnits="Absolute">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing>
                <GeometryDrawing.Pen><Pen Brush="White" Thickness="1"/></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                  <GeometryGroup>
                    <LineGeometry StartPoint="47,0" EndPoint="47,47"/>
                    <LineGeometry StartPoint="0,47" EndPoint="47,47"/>
                  </GeometryGroup>
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Vignette -->
    <Rectangle Fill="{StaticResource Vignette}"/>

    <!-- TOP BAR -->
    <Grid Margin="64,46,64,0" VerticalAlignment="Top" Height="62">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Logo + Club Name -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Hexagon logo -->
        <Path Data="M17,0 L34,9.5 L34,28.5 L17,38 L0,28.5 L0,9.5 Z"
              Margin="0,0,16,0" Fill="{StaticResource LogoGradient}" Width="34" Height="38"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding ClubName}" Foreground="White"
                     FontFamily="{StaticResource FontChakra}" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="GAMING CLUB" Foreground="{StaticResource CyanBrush}"
                     FontFamily="{StaticResource FontMono}" FontSize="15"/>
        </StackPanel>
      </StackPanel>

      <!-- Time + Lock Badge -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding CurrentTime}" Foreground="{StaticResource TextSecondary}"
                   FontFamily="{StaticResource FontMono}" FontSize="26" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Border CornerRadius="999" BorderThickness="1" Padding="20,11"
                Background="#19FF3B5C" BorderBrush="#66FF3B5C" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="{StaticResource RedBrush}" Margin="0,0,10,0">
              <Ellipse.Effect>
                <DropShadowEffect Color="#FFFF3B5C" BlurRadius="12" ShadowDepth="0"/>
              </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="LOCKED · BLOKLANGAN" Foreground="{StaticResource RedSoftBrush}"
                       FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- CENTER CONTENT -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">

      <!-- PC-12 -->
      <TextBlock Text="{Binding PcId}" HorizontalAlignment="Center"
                 FontFamily="{StaticResource FontChakra}" FontSize="100" FontWeight="Bold">
        <TextBlock.Foreground>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White"     Offset="0"/>
            <GradientStop Color="#FF9FB4C9" Offset="1"/>
          </LinearGradientBrush>
        </TextBlock.Foreground>
      </TextBlock>

      <!-- Zone badge -->
      <Border CornerRadius="999" BorderThickness="1" Padding="26,9"
              Background="#14FFFFFF" BorderBrush="#5900D4FF"
              HorizontalAlignment="Center" Margin="0,16,0,0">
        <TextBlock Text="{Binding ZoneLabel}" Foreground="#FFCFE9F5"
                   FontFamily="{StaticResource FontChakra}" FontSize="22" FontWeight="Medium"/>
      </Border>

      <!-- QR pay frame with glow pulse -->
      <Border x:Name="QrPayFrame" CornerRadius="20" Background="White" Padding="22"
              HorizontalAlignment="Center" Margin="0,38,0,0">
        <Border.Effect>
          <DropShadowEffect x:Name="QrPayGlow" Color="#FF00D4FF"
                            BlurRadius="46" ShadowDepth="0" Opacity="0.22"/>
        </Border.Effect>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="QrPayGlow"
                                 Storyboard.TargetProperty="BlurRadius"
                                 From="46" To="78" Duration="0:0:1.6"/>
                <DoubleAnimation Storyboard.TargetName="QrPayGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.22" To="0.5" Duration="0:0:1.6"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Image Source="{Binding PayQrImage}" Width="300" Height="300"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>

      <!-- Scan hint -->
      <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0"
                 FontFamily="{StaticResource FontChakra}" FontSize="26" FontWeight="SemiBold">
        <Run Text="Scan to pay " Foreground="White"/>
        <Run Text=" · " Foreground="#5A6270"/>
        <Run Text="To'lov uchun skanerlang" Foreground="{StaticResource GreenBrush}"/>
      </TextBlock>
    </StackPanel>

    <!-- WIFI CORNER (bottom-left) -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                HorizontalAlignment="Left" Margin="64,0,0,44">
      <Border CornerRadius="12" Background="White" Padding="10">
        <Image Source="{Binding WifiQrImage}" Width="108" Height="108"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="320">
        <TextBlock Text="No internet? Connect to WiFi first"
                   Foreground="{StaticResource TextSecondary}"
                   FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Internet yo'qmi? Avval WiFi'ga ulaning · Нет интернета? Подключитесь к WiFi"
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                   FontFamily="{StaticResource FontMono}" FontSize="14" Margin="0,3,0,0"/>
      </StackPanel>
    </StackPanel>

    <!-- PRESS ANY KEY (bottom-center) -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,44">
      <TextBlock Text="Press any key to enter unlock code · Kodni kiritish uchun istalgan tugmani bosing"
                 Foreground="{StaticResource TextDimmed}"
                 FontFamily="{StaticResource FontMono}" FontSize="19"
                 VerticalAlignment="Center"/>
      <Rectangle x:Name="Caret" Width="11" Height="22" Fill="{StaticResource CyanBrush}"
                 Margin="8,0,0,0" VerticalAlignment="Center">
        <Rectangle.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.55" AutoReverse="True"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Rectangle.Triggers>
      </Rectangle>
    </StackPanel>

    <!-- CODE INPUT OVERLAY -->
    <Grid Visibility="{Binding IsCodeInputVisible, Converter={StaticResource BoolVis}}"
          Background="#CC0D1117">
      <Border CornerRadius="22" Padding="48,40" HorizontalAlignment="Center"
              VerticalAlignment="Center" Width="620">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1A1A2E" Offset="0"/>
            <GradientStop Color="#FF0D1117" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <SolidColorBrush Color="#FF00D4FF" Opacity="0.3"/>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
          <DropShadowEffect Color="#FF00D4FF" BlurRadius="60" ShadowDepth="0" Opacity="0.08"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Kodni kiriting · Enter unlock code"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource TextSecondary}"
                     FontFamily="{StaticResource FontChakra}" FontSize="22"
                     FontWeight="Medium" Margin="0,0,0,20"/>

          <!-- Code field -->
          <Border CornerRadius="16" Background="#0DFFFFFF"
                  BorderThickness="2" Height="92" Padding="30,0">
            <Border.BorderBrush>
              <SolidColorBrush Color="#FF00D4FF" Opacity="0.5"/>
            </Border.BorderBrush>
            <Grid>
              <TextBlock Text="{Binding CodeInput}" VerticalAlignment="Center"
                         FontFamily="{StaticResource FontMono}" FontSize="46"
                         FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
              <Rectangle x:Name="CodeCaret" Width="4" Height="48" Fill="{StaticResource CyanBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                <Rectangle.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1" To="0" Duration="0:0:0.55" AutoReverse="True"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Rectangle.Triggers>
              </Rectangle>
            </Grid>
          </Border>

          <TextBlock Text="8 characters · 8 ta belgi · format XXXX-XXXX"
                     HorizontalAlignment="Center" Margin="0,8,0,0"
                     Foreground="{StaticResource TextDimmed}"
                     FontFamily="{StaticResource FontMono}" FontSize="15"/>

          <!-- Error -->
          <TextBlock Text="{Binding CodeError}" HorizontalAlignment="Center"
                     Foreground="{StaticResource RedBrush}"
                     FontFamily="{StaticResource FontChakra}" FontSize="16" Margin="0,12,0,0"
                     Visibility="{Binding HasCodeError, Converter={StaticResource BoolVis}}"/>

          <!-- Close hint -->
          <TextBlock Text="Esc — yopish · close" HorizontalAlignment="Center" Margin="0,16,0,0"
                     Foreground="{StaticResource TextDimmed}"
                     FontFamily="{StaticResource FontMono}" FontSize="13"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
