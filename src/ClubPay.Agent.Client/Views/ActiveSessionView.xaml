<UserControl x:Class="ClubPay.Agent.Client.Views.ActiveSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Width="380">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter    x:Key="BoolVis"/>
    <cv:TimerToBrushConverter        x:Key="TimerBrush"/>
  </UserControl.Resources>

  <StackPanel>

    <!-- MAIN WIDGET CARD -->
    <Border CornerRadius="22" BorderThickness="1" BorderBrush="#4700D4FF" Padding="22">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="#FF00D4FF" BlurRadius="50" ShadowDepth="0" Opacity="0.07"/>
      </Border.Effect>

      <StackPanel>
        <!-- Header row -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M13,0 L26,7.25 L26,21.75 L13,29 L0,21.75 L0,7.25 Z"
                  Fill="{StaticResource LogoGradient}" Width="26" Height="29" Margin="0,0,11,0"/>
            <TextBlock Text="{Binding ClubName}" Foreground="White"
                       FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="Bold"/>
          </StackPanel>
          <ComboBox Grid.Column="1" Style="{StaticResource LanguagePicker}" Margin="0,0,10,0"
                    SelectedValue="{Binding Source={StaticResource Loc}, Path=LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Tag" VerticalContentAlignment="Center">
            <ComboBoxItem Content="RU" Tag="ru"/>
            <ComboBoxItem Content="UZ" Tag="uz"/>
          </ComboBox>
          <!-- Player menu. Windows controls stay hidden; player actions live here instead. -->
        <Button x:Name="SessionMenuButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                Background="#0FFFFFFF"
                BorderBrush="#1AFFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnMenuClicked"
                ToolTip="{Binding Source={StaticResource Loc}, Path=[Menu], Mode=OneWay}">
            <TextBlock Text="⋮"
                       FontSize="20"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>
        </Grid>

        <!-- Status indicator -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,0,9,0"
                   VerticalAlignment="Center">
            <Ellipse.Effect>
              <DropShadowEffect Color="#FF00FF88" BlurRadius="10" ShadowDepth="0"/>
            </Ellipse.Effect>
          </Ellipse>
          <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ActiveSession], Mode=OneWay}" Foreground="{StaticResource GreenBrush}"
                     FontFamily="{StaticResource FontMono}" FontSize="16"/>
        </StackPanel>

        <!-- Timer countdown -->
        <TextBlock Text="{Binding RemainingTimeText}" Margin="0,6,0,0"
                   FontFamily="{StaticResource FontMono}" FontSize="18" FontWeight="Bold"
                   Foreground="{Binding RemainingSeconds, Converter={StaticResource TimerBrush}}">
          <TextBlock.Effect>
            <DropShadowEffect x:Name="TimerGlow" Color="#FF00FF88"
                              BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="TimerGlow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="16" To="36" Duration="0:0:1.3"/>
                  <DoubleAnimation Storyboard.TargetName="TimerGlow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.45" To="0.85" Duration="0:0:1.3"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Remaining], Mode=OneWay}"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontMono}" FontSize="13"/>

        <!-- Zone + Tariff info row -->
        <Grid Margin="0,14,0,0">
          <Grid.Background>
            <SolidColorBrush Color="#FFFFFFFF" Opacity="0.04"/>
          </Grid.Background>
          <Border CornerRadius="14" Background="#07FFFFFF" Padding="18,14">
            <Grid>
              <StackPanel>
                <TextBlock Text="{Binding ZoneLabel}" Foreground="White"
                           FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Divider -->
        <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,16"/>

        <!-- Extend QR row -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="12" Background="White" Padding="10">
            <Border.Effect>
              <DropShadowEffect x:Name="ExtendQrGlow" Color="#FF00D4FF"
                                BlurRadius="46" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Border.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="ExtendQrGlow"
                                     Storyboard.TargetProperty="BlurRadius"
                                     From="46" To="78" Duration="0:0:1.6"/>
                    <DoubleAnimation Storyboard.TargetName="ExtendQrGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.22" To="0.5" Duration="0:0:1.6"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Border.Triggers>
            <Image Source="{Binding ExtendQrImage}" Width="96" Height="96"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ScanToExtendSession], Mode=OneWay}" Foreground="{StaticResource CyanBrush}"
                       FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ScanToExtendHelp], Mode=OneWay}" Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
