<UserControl x:Class="ClubPay.Agent.Client.Views.ActiveSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Width="380">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter    x:Key="BoolVis"/>
    <cv:TimerToBrushConverter        x:Key="TimerBrush"/>
  </UserControl.Resources>

  <StackPanel>

    <!-- MAIN WIDGET CARD -->
    <Border CornerRadius="22" BorderThickness="1" BorderBrush="#4700D4FF" Padding="22">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="#FF00D4FF" BlurRadius="50" ShadowDepth="0" Opacity="0.07"/>
      </Border.Effect>

      <StackPanel>
        <!-- Header row -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M13,0 L26,7.25 L26,21.75 L13,29 L0,21.75 L0,7.25 Z"
                  Fill="{StaticResource LogoGradient}" Width="26" Height="29" Margin="0,0,11,0"/>
            <TextBlock Text="NEXUS ARENA" Foreground="White"
                       FontFamily="{StaticResource FontChakra}" FontSize="15" FontWeight="Bold"/>
          </StackPanel>
          <!-- Minimize icon -->
          <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8"
                  Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                  Cursor="Hand">
            <Rectangle Width="16" Height="2" Fill="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>

        <!-- Status indicator -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,0,9,0"
                   VerticalAlignment="Center">
            <Ellipse.Effect>
              <DropShadowEffect Color="#FF00FF88" BlurRadius="10" ShadowDepth="0"/>
            </Ellipse.Effect>
          </Ellipse>
          <TextBlock Text="ACTIVE SESSION · FAOL SEANS" Foreground="{StaticResource GreenBrush}"
                     FontFamily="{StaticResource FontMono}" FontSize="16"/>
        </StackPanel>

        <!-- Timer countdown -->
        <TextBlock Text="{Binding RemainingTimeText}" Margin="0,6,0,0"
                   FontFamily="{StaticResource FontMono}" FontSize="60" FontWeight="Bold"
                   Foreground="{Binding RemainingSeconds, Converter={StaticResource TimerBrush}}">
          <TextBlock.Effect>
            <DropShadowEffect x:Name="TimerGlow" Color="#FF00FF88"
                              BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="TimerGlow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="16" To="36" Duration="0:0:1.3"/>
                  <DoubleAnimation Storyboard.TargetName="TimerGlow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.45" To="0.85" Duration="0:0:1.3"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>
        <TextBlock Text="remaining · qolgan vaqt · осталось"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontMono}" FontSize="13"/>

        <!-- Zone + Tariff info row -->
        <Grid Margin="0,14,0,0">
          <Grid.Background>
            <SolidColorBrush Color="#FFFFFFFF" Opacity="0.04"/>
          </Grid.Background>
          <Border CornerRadius="14" Background="#07FFFFFF" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding ZoneLabel}" Foreground="White"
                           FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ZoneLabelUz}" Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding TariffLabel}" Foreground="{StaticResource CyanBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Divider -->
        <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,16"/>

        <!-- Extend QR row -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="12" Background="White" Padding="10">
            <Border.Effect>
              <DropShadowEffect x:Name="ExtendQrGlow" Color="#FF00D4FF"
                                BlurRadius="46" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Border.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="ExtendQrGlow"
                                     Storyboard.TargetProperty="BlurRadius"
                                     From="46" To="78" Duration="0:0:1.6"/>
                    <DoubleAnimation Storyboard.TargetName="ExtendQrGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.22" To="0.5" Duration="0:0:1.6"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Border.Triggers>
            <Image Source="{Binding ExtendQrImage}" Width="96" Height="96"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="SemiBold">
              <Run Text="Scan to extend" Foreground="White"/>
              <LineBreak/>
              <Run Text="session" Foreground="{StaticResource CyanBrush}"/>
            </TextBlock>
            <TextBlock Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,4,0,0">
              <Run Text="Seansni uzaytirish"/>
              <LineBreak/>
              <Run Text="uchun skanerlang"/>
            </TextBlock>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- WARNING STATES (preview cards) -->
    <TextBlock Text="TIME-LEFT STATES · VAQT HOLATLARI" Margin="0,24,0,0"
               Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource FontMono}"
               FontSize="14" Visibility="{Binding IsWarn10Visible, Converter={StaticResource BoolVis}}"/>

    <!-- 10 min warning -->
    <Border Margin="0,10,0,0" CornerRadius="16" BorderThickness="1"
            Padding="16,14" BorderBrush="#66FFD60A"
            Visibility="{Binding IsWarn10Visible, Converter={StaticResource BoolVis}}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding RemainingTimeText}"
                   Foreground="{StaticResource YellowBrush}"
                   FontFamily="{StaticResource FontMono}" FontSize="36" FontWeight="Bold">
          <TextBlock.Effect>
            <DropShadowEffect Color="#FFFFD60A" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
          </TextBlock.Effect>
        </TextBlock>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="10 daqiqa qoldi" Foreground="{StaticResource YellowBrush}"
                     FontFamily="{StaticResource FontChakra}" FontSize="14" FontWeight="SemiBold"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="Warning · Осталось 10 мин" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="11"
                     HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 1 min critical -->
    <Border Margin="0,10,0,0" CornerRadius="16" BorderThickness="1"
            Padding="16,14" BorderBrush="#80FF3B5C"
            Visibility="{Binding IsWarn1Visible, Converter={StaticResource BoolVis}}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F7280A1A" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding RemainingTimeText}"
                   Foreground="{StaticResource RedBrush}"
                   FontFamily="{StaticResource FontMono}" FontSize="36" FontWeight="Bold">
          <TextBlock.Effect>
            <DropShadowEffect x:Name="Warn1Glow" Color="#FFFF3B5C"
                              BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="Warn1Glow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="18" To="42" Duration="0:0:0.7"/>
                  <DoubleAnimation Storyboard.TargetName="Warn1Glow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.5" To="0.95" Duration="0:0:0.7"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="1 daqiqa!" Foreground="#FFFF6378"
                     FontFamily="{StaticResource FontChakra}" FontSize="14" FontWeight="SemiBold"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="Critical · 1 минута!" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="11"
                     HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
