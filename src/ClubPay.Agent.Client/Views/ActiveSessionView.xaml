<UserControl x:Class="ClubPay.Agent.Client.Views.ActiveSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Width="292">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter    x:Key="BoolVis"/>
    <cv:TimerToBrushConverter        x:Key="TimerBrush"/>
  </UserControl.Resources>

  <StackPanel>

    <!-- MAIN WIDGET CARD -->
    <Border CornerRadius="22" BorderThickness="1" BorderBrush="#4700D4FF" Padding="16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="#FF00D4FF" BlurRadius="50" ShadowDepth="0" Opacity="0.07"/>
      </Border.Effect>

      <StackPanel>
        <!-- Header row -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- The club name is intentionally in the launcher header, where it
               has room. This card keeps only the player controls. -->
          <TextBlock Grid.Column="1" Text="{Binding RemainingTimeText}"
                     Margin="0,0,10,0" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontMono}" FontSize="14" FontWeight="Bold"
                     Foreground="{Binding RemainingSeconds, Converter={StaticResource TimerBrush}}"/>
          <ComboBox Grid.Column="2" Style="{StaticResource LanguagePicker}" Margin="0,0,10,0"
                    SelectedValue="{Binding Source={StaticResource Loc}, Path=LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Tag" VerticalContentAlignment="Center">
            <ComboBoxItem Content="RU" Tag="ru"/>
            <ComboBoxItem Content="UZ" Tag="uz"/>
          </ComboBox>
          <!-- Player menu. Windows controls stay hidden; player actions live here instead. -->
        <Button x:Name="SessionMenuButton"
                Grid.Column="3"
                Width="32"
                Height="32"
                Padding="0"
                Background="#0FFFFFFF"
                BorderBrush="#1AFFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnMenuClicked"
                ToolTip="{Binding Source={StaticResource Loc}, Path=[Menu], Mode=OneWay}">
            <TextBlock Text="⋮"
                       FontSize="20"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>
        </Grid>

        <!-- Compact context: extension is controlled from the player's phone. -->
        <TextBlock Text="{Binding ZoneLabel}" Margin="0,18,0,0"
                   Foreground="{StaticResource TextSecondary}"
                   FontFamily="{StaticResource FontChakra}" FontSize="14"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ManageSessionOnPhone], Mode=OneWay}"
                   Margin="0,4,0,0" Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontMono}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
