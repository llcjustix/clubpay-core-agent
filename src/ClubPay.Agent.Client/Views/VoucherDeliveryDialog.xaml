<Window x:Class="ClubPay.Agent.Client.Views.VoucherDeliveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={StaticResource Loc}, Path=[VoucherTitle]}" SizeToContent="WidthAndHeight" MinWidth="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource BgDark}" Foreground="White">
  <Border Padding="28" BorderBrush="#4700D4FF" BorderThickness="1" CornerRadius="14">
    <StackPanel HorizontalAlignment="Center">
      <TextBlock x:Name="TitleText" Text="{Binding Source={StaticResource Loc}, Path=[SessionCompleted]}" FontFamily="{StaticResource FontChakra}"
                 FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{StaticResource TextSecondary}" Margin="0,8,0,14"/>
      <Border x:Name="QrBorder" Background="White" Padding="10" CornerRadius="10" HorizontalAlignment="Center">
        <Image x:Name="QrImage" Width="210" Height="210" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <TextBlock x:Name="TelegramBotText" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock x:Name="VoucherCodeText" FontFamily="{StaticResource FontMono}" FontSize="20"
                 FontWeight="Bold" Foreground="{StaticResource CyanBrush}" TextAlignment="Center" Margin="0,16,0,0"/>
      <Button Content="{Binding Source={StaticResource Loc}, Path=[Done]}" Padding="18,8" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnClose"/>
    </StackPanel>
  </Border>
</Window>
