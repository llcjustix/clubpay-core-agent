<Window x:Class="ClubPay.Agent.Client.Views.KioskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClubPay.Agent.Client.Views"
        xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource BgDark}">

  <Window.Resources>
    <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
    <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
  </Window.Resources>

  <Grid>
    <!-- Lock Screen (shown when Locked) -->
    <Grid Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
      <views:LockScreenView DataContext="{Binding LockScreen}"/>
    </Grid>

    <!-- Freeze Overlay (shown when Frozen) -->
    <Grid Visibility="{Binding IsFrozen, Converter={StaticResource BoolVis}}">
      <views:FreezeView DataContext="{Binding Freeze}"/>
    </Grid>
  </Grid>
</Window>
