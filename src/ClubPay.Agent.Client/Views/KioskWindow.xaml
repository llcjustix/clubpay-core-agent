<Window x:Class="ClubPay.Agent.Client.Views.KioskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClubPay.Agent.Client.Views"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource BgDark}">

  <Grid>
    <!-- Lock Screen (shown when Locked) -->
    <Grid Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
      <views:LockScreenView DataContext="{Binding LockScreen}"/>
    </Grid>

    <!-- Freeze Overlay (shown when Frozen) -->
    <Grid Visibility="{Binding IsFrozen, Converter={StaticResource BoolVis}}">
      <views:FreezeView DataContext="{Binding Freeze}"/>
    </Grid>

    <!-- ТЗ §11/§23 state badges: repair mode and manager lock must be visible on the kiosk -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,120,64,0">
      <Border Visibility="{Binding IsRepairMode, Converter={StaticResource BoolVis}}"
              CornerRadius="999" BorderThickness="1" Padding="20,10" Margin="0,0,12,0"
              Background="#19FFD60A" BorderBrush="#66FFD60A">
        <TextBlock Text="TA'MIRDA · РЕМОНТ" Foreground="{StaticResource YellowBrush}"
                   FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="SemiBold"/>
      </Border>
      <Border Visibility="{Binding IsManagerLocked, Converter={StaticResource BoolVis}}"
              CornerRadius="999" BorderThickness="1" Padding="20,10"
              Background="#1900D4FF" BorderBrush="#6600D4FF">
        <TextBlock Text="MENEJER BLOKI · БЛОК МЕНЕДЖЕРА" Foreground="{StaticResource CyanBrush}"
                   FontFamily="{StaticResource FontChakra}" FontSize="17" FontWeight="SemiBold"/>
      </Border>
    </StackPanel>
  </Grid>
</Window>
