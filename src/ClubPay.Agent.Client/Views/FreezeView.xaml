<UserControl x:Class="ClubPay.Agent.Client.Views.FreezeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Background="{StaticResource BgDark}"
             KeyDown="OnKeyDown" Focusable="True">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <cv:GraceToWidthConverter     x:Key="GraceWidth" TotalWidth="520"/>
  </UserControl.Resources>

  <Grid>
    <!-- Background gradient -->
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#FF0D1117" Offset="0"/>
          <GradientStop Color="#FF1A1422" Offset="0.55"/>
          <GradientStop Color="#FF0D1117" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Red glow vignette -->
    <Rectangle Fill="{StaticResource FreezeVignette}" IsHitTestVisible="False"/>

    <!-- Red inner shadow -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
          <GradientStop Color="#00FF3B5C" Offset="0.5"/>
          <GradientStop Color="#22FF3B5C" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="96,0">

      <!-- HEADER: SESSION FROZEN -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"
              CornerRadius="999" BorderThickness="1" BorderBrush="#72FF3B5C"
              Background="#1AFF3B5C" Padding="26,11">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="11" Height="11" Fill="{StaticResource RedBrush}" Margin="0,0,11,0"
                   VerticalAlignment="Center">
            <Ellipse.Effect>
              <DropShadowEffect Color="#FFFF3B5C" BlurRadius="14" ShadowDepth="0"/>
            </Ellipse.Effect>
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="1" To="0" Duration="0:0:0.6" AutoReverse="True"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>
          <TextBlock Text="SESSION FROZEN · SEANS MUZLATILDI"
                     Foreground="{StaticResource RedSoftBrush}"
                     FontFamily="{StaticResource FontChakra}" FontSize="22"
                     FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <!-- GRACE TIMER + BAR -->
      <StackPanel VerticalAlignment="Top" Margin="0,118,0,0" HorizontalAlignment="Center">
        <TextBlock Text="GRACE PERIOD · IMTIYOZ VAQTI · ЛЬГОТНОЕ ВРЕМЯ"
                   HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontMono}" FontSize="18"/>

        <TextBlock Text="{Binding GraceTimeText}" HorizontalAlignment="Center"
                   FontFamily="{StaticResource FontMono}" FontSize="96" FontWeight="Bold"
                   Foreground="{StaticResource RedBrush}" Margin="0,4,0,0">
          <TextBlock.Effect>
            <DropShadowEffect x:Name="GraceGlow" Color="#FFFF3B5C"
                              BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="GraceGlow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="18" To="42" Duration="0:0:0.8"/>
                  <DoubleAnimation Storyboard.TargetName="GraceGlow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.5" To="0.95" Duration="0:0:0.8"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>

        <!-- Drain bar -->
        <Grid Width="520" Height="8" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Rectangle Fill="#14FFFFFF" RadiusX="4" RadiusY="4"/>
          <Rectangle HorizontalAlignment="Left" RadiusX="4" RadiusY="4"
                     Width="{Binding GraceBarWidth}">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFFF3B5C" Offset="0"/>
                <GradientStop Color="#FFFF8094" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>
      </StackPanel>

      <!-- TWO COLUMN AREA (bottom) -->
      <Grid VerticalAlignment="Bottom" Margin="0,0,0,80">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="72"/>
          <ColumnDefinition Width="560"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Big QR (extend payment) -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
          <Border CornerRadius="22" Background="White" Padding="22">
            <Border.Effect>
              <DropShadowEffect x:Name="FreezeQrGlow" Color="#FF00FF88"
                                BlurRadius="46" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Border.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="FreezeQrGlow"
                                     Storyboard.TargetProperty="BlurRadius"
                                     From="46" To="78" Duration="0:0:1.4"/>
                    <DoubleAnimation Storyboard.TargetName="FreezeQrGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.22" To="0.5" Duration="0:0:1.4"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Border.Triggers>
            <Image Source="{Binding ExtendQrImage}" Width="320" Height="320"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </Border>
          <TextBlock Text="Scan to continue playing" HorizontalAlignment="Center"
                     Foreground="White" FontFamily="{StaticResource FontChakra}"
                     FontSize="30" FontWeight="SemiBold" Margin="0,20,0,0"/>
          <TextBlock Text="O'ynashni davom ettirish uchun skanerlang" HorizontalAlignment="Center"
                     Foreground="{StaticResource GreenBrush}"
                     FontFamily="{StaticResource FontMono}" FontSize="19" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- RIGHT: Upsell + Voucher code -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center">

          <!-- Upsell card -->
          <Border CornerRadius="20" BorderThickness="1" Padding="28,28">
            <Border.Background>
              <SolidColorBrush Color="#FF00FF88" Opacity="0.07"/>
            </Border.Background>
            <Border.BorderBrush>
              <SolidColorBrush Color="#FF00FF88" Opacity="0.45"/>
            </Border.BorderBrush>
            <Border.Effect>
              <DropShadowEffect Color="#FF00FF88" BlurRadius="40" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="SPECIAL OFFER · MAXSUS TAKLIF"
                         Foreground="#FF9FB0A6" FontFamily="{StaticResource FontMono}" FontSize="16"/>
              <TextBlock Margin="0,8,0,0"
                         Foreground="#FFE8F7EE" FontFamily="{StaticResource FontChakra}"
                         FontSize="24" FontWeight="Medium" TextWrapping="Wrap">
                <Run Text="{Binding UpsellLine1}"/>
                <LineBreak/>
                <Run Text="{Binding UpsellLine1Uz}" Foreground="#FF9FB0A6"
                     FontFamily="JetBrains Mono, Consolas" FontSize="18"/>
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding DiscountTiyin, Converter={StaticResource TiyinSom}}"
                           Foreground="{StaticResource GreenBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="52" FontWeight="Bold"/>
                <TextBlock Text=" / soat" Foreground="{StaticResource CyanSoftBrush}"
                           FontFamily="{StaticResource FontChakra}" FontSize="22" FontWeight="Medium"
                           VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding OriginalTiyin, Converter={StaticResource TiyinSom}}"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontMono}" FontSize="26"
                           TextDecorations="Strikethrough" VerticalAlignment="Bottom"
                           Margin="16,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Voucher code input -->
          <StackPanel Margin="0,26,0,0">
            <TextBlock Text="Or enter code below · Yoki kodni kiriting"
                       Foreground="#FF9AA3B2" FontFamily="{StaticResource FontChakra}"
                       FontSize="19"/>
            <Border Margin="0,12,0,0" CornerRadius="16" Height="92" Padding="30,0"
                    Background="#0DFFFFFF" BorderThickness="2">
              <Border.BorderBrush>
                <SolidColorBrush Color="#FF00D4FF" Opacity="0.5"/>
              </Border.BorderBrush>
              <Grid>
                <TextBlock Text="{Binding VoucherInput}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontMono}" FontSize="46"
                           FontWeight="Bold" Foreground="#FF5D6573"/>
                <Rectangle x:Name="VoucherCaret" Width="4" Height="48" Fill="{StaticResource CyanBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                  <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="1" To="0" Duration="0:0:0.55" AutoReverse="True"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Rectangle.Triggers>
                </Rectangle>
              </Grid>
            </Border>
            <TextBlock Text="8 characters · 8 ta belgi · format XXXX-XXXX"
                       Foreground="{StaticResource TextDimmed}"
                       FontFamily="{StaticResource FontMono}" FontSize="15" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding VoucherError}" Foreground="{StaticResource RedBrush}"
                       FontFamily="{StaticResource FontChakra}" FontSize="16" Margin="0,8,0,0"
                       Visibility="{Binding HasVoucherError, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
