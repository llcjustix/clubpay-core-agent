<UserControl x:Class="ClubPay.Agent.Client.Views.FreezeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters"
             Background="{StaticResource BgDark}">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <cv:GraceToWidthConverter     x:Key="GraceWidth" TotalWidth="520"/>
  </UserControl.Resources>

  <Viewbox Stretch="Uniform">
  <Grid Width="1920" Height="1080">
    <!-- Background gradient -->
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#FF0D1117" Offset="0"/>
          <GradientStop Color="#FF1A1422" Offset="0.55"/>
          <GradientStop Color="#FF0D1117" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Red glow vignette -->
    <Rectangle Fill="{StaticResource FreezeVignette}" IsHitTestVisible="False"/>

    <!-- Red inner shadow -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
          <GradientStop Color="#00FF3B5C" Offset="0.5"/>
          <GradientStop Color="#22FF3B5C" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="96,0">

      <ComboBox Width="78" Height="34" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,54,0,0"
                Foreground="{StaticResource TextSecondary}" Background="#1AFFFFFF" BorderBrush="#66FF3B5C"
                SelectedValue="{Binding Source={StaticResource Loc}, Path=LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Tag" VerticalContentAlignment="Center">
        <ComboBoxItem Content="RU" Tag="ru"/>
        <ComboBoxItem Content="UZ" Tag="uz"/>
      </ComboBox>

      <!-- HEADER: SESSION FROZEN -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"
              CornerRadius="999" BorderThickness="1" BorderBrush="#72FF3B5C"
              Background="#1AFF3B5C" Padding="26,11">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="11" Height="11" Fill="{StaticResource RedBrush}" Margin="0,0,11,0"
                   VerticalAlignment="Center">
            <Ellipse.Effect>
              <DropShadowEffect Color="#FFFF3B5C" BlurRadius="14" ShadowDepth="0"/>
            </Ellipse.Effect>
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="1" To="0" Duration="0:0:0.6" AutoReverse="True"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>
          <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SessionFrozen], Mode=OneWay}"
                     Foreground="{StaticResource RedSoftBrush}"
                     FontFamily="{StaticResource FontChakra}" FontSize="22"
                     FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <!-- GRACE TIMER + BAR -->
      <StackPanel VerticalAlignment="Top" Margin="0,118,0,0" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[GracePeriod], Mode=OneWay}"
                   HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontMono}" FontSize="18"/>

        <TextBlock Text="{Binding GraceTimeText}" HorizontalAlignment="Center"
                   FontFamily="{StaticResource FontMono}" FontSize="96" FontWeight="Bold"
                   Foreground="{StaticResource RedBrush}" Margin="0,4,0,0">
          <TextBlock.Effect>
            <DropShadowEffect x:Name="GraceGlow" Color="#FFFF3B5C"
                              BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="GraceGlow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="18" To="42" Duration="0:0:0.8"/>
                  <DoubleAnimation Storyboard.TargetName="GraceGlow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.5" To="0.95" Duration="0:0:0.8"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>

        <!-- Drain bar -->
        <Grid Width="520" Height="8" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Rectangle Fill="#14FFFFFF" RadiusX="4" RadiusY="4"/>
          <Rectangle HorizontalAlignment="Left" RadiusX="4" RadiusY="4"
                     Width="{Binding GraceBarWidth}">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFFF3B5C" Offset="0"/>
                <GradientStop Color="#FFFF8094" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>
      </StackPanel>

      <!-- QR (extend payment) -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,80">
        <Border CornerRadius="22" Background="White" Padding="22" HorizontalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect x:Name="FreezeQrGlow" Color="#FF00FF88"
                              BlurRadius="46" ShadowDepth="0" Opacity="0.22"/>
          </Border.Effect>
          <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="FreezeQrGlow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="46" To="78" Duration="0:0:1.4"/>
                  <DoubleAnimation Storyboard.TargetName="FreezeQrGlow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.22" To="0.5" Duration="0:0:1.4"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
          <Image Source="{Binding ExtendQrImage}" Width="320" Height="320"
                 RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ScanToContinuePlaying], Mode=OneWay}" HorizontalAlignment="Center"
                   Foreground="White" FontFamily="{StaticResource FontChakra}"
                   FontSize="30" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ScanToContinuePlayingHelp], Mode=OneWay}" HorizontalAlignment="Center"
                   Foreground="{StaticResource GreenBrush}"
                   FontFamily="{StaticResource FontMono}" FontSize="19" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
  </Viewbox>
</UserControl>
