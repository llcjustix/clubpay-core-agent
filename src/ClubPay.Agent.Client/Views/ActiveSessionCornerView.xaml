<UserControl x:Class="ClubPay.Agent.Client.Views.ActiveSessionCornerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters">

  <UserControl.Resources>
    <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
    <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    <cv:TimerToBrushConverter            x:Key="TimerBrush"/>
  </UserControl.Resources>

  <!-- Passive, always-on corner widget (ТЗ §22 "не мешает игре"): normally just a small static
       time readout — no card, no logo, no animation, no permanent QR. The full session card lives
       in ActiveSessionFullView, shown only inside the hotkey-toggled shell (GameLauncherWindow).
       The extend-QR appears here only during the low-time warning window (ТЗ §7 "по уведомлению
       «мало времени» QR виден в углу экрана"), tied to the already-tested IsAnyWarningVisible. -->
  <StackPanel Width="220">

    <!-- Idle-state pill: small static countdown, no warning active -->
    <Border CornerRadius="10" Background="#B30D1117" Padding="12,7"
            Visibility="{Binding IsAnyWarningVisible, Converter={StaticResource InvBoolVis}}">
      <TextBlock Text="{Binding RemainingTimeText}"
                 Foreground="{Binding RemainingSeconds, Converter={StaticResource TimerBrush}}"
                 FontFamily="{StaticResource FontMono}" FontSize="18" FontWeight="Bold"
                 HorizontalAlignment="Right"/>
    </Border>

    <!-- 10 min warning (soft) -->
    <Border Margin="0,10,0,0" CornerRadius="16" BorderThickness="1"
            Padding="16,14" BorderBrush="#66FFD60A"
            Visibility="{Binding IsSoft10Visible, Converter={StaticResource BoolVis}}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding RemainingTimeText}"
                   Foreground="{StaticResource YellowBrush}"
                   FontFamily="{StaticResource FontMono}" FontSize="30" FontWeight="Bold">
          <TextBlock.Effect>
            <DropShadowEffect Color="#FFFFD60A" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
          </TextBlock.Effect>
        </TextBlock>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="10 daqiqa qoldi" Foreground="{StaticResource YellowBrush}"
                     FontFamily="{StaticResource FontChakra}" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="Warning · Осталось 10 мин" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="10"
                     HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 5 min warning (toast, o'z-o'zidan yopiladi) -->
    <Border Margin="0,10,0,0" CornerRadius="16" BorderThickness="1"
            Padding="16,14" BorderBrush="#80FF8A0A"
            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolVis}}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F72A1A0E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding RemainingTimeText}"
                   Foreground="#FFFF8A0A"
                   FontFamily="{StaticResource FontMono}" FontSize="30" FontWeight="Bold">
          <TextBlock.Effect>
            <DropShadowEffect Color="#FFFF8A0A" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
          </TextBlock.Effect>
        </TextBlock>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="5 daqiqa qoldi" Foreground="#FFFF8A0A"
                     FontFamily="{StaticResource FontChakra}" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="Warning · Осталось 5 мин" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="10"
                     HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 1 min critical (banner) -->
    <Border Margin="0,10,0,0" CornerRadius="16" BorderThickness="1"
            Padding="16,14" BorderBrush="#80FF3B5C"
            Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolVis}}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F7280A1A" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding RemainingTimeText}"
                   Foreground="{StaticResource RedBrush}"
                   FontFamily="{StaticResource FontMono}" FontSize="30" FontWeight="Bold">
          <TextBlock.Effect>
            <DropShadowEffect x:Name="Warn1Glow" Color="#FFFF3B5C"
                              BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="Warn1Glow"
                                   Storyboard.TargetProperty="BlurRadius"
                                   From="18" To="42" Duration="0:0:0.7"/>
                  <DoubleAnimation Storyboard.TargetName="Warn1Glow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.5" To="0.95" Duration="0:0:0.7"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="1 daqiqa!" Foreground="#FFFF6378"
                     FontFamily="{StaticResource FontChakra}" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="Critical · 1 минута!" Foreground="{StaticResource TextMuted}"
                     FontFamily="{StaticResource FontMono}" FontSize="10"
                     HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Extend QR — only during the low-time warning window (ТЗ §7: QR appears "по уведомлению
         «мало времени»"), not for the whole session. -->
    <Border Margin="0,10,0,0" CornerRadius="12" Background="White" Padding="8"
            Visibility="{Binding IsAnyWarningVisible, Converter={StaticResource BoolVis}}">
      <Border.Effect>
        <DropShadowEffect x:Name="CornerQrGlow" Color="#FF00D4FF"
                          BlurRadius="30" ShadowDepth="0" Opacity="0.25"/>
      </Border.Effect>
      <Border.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="3x" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="CornerQrGlow"
                               Storyboard.TargetProperty="BlurRadius"
                               From="30" To="50" Duration="0:0:1.2"/>
              <DoubleAnimation Storyboard.TargetName="CornerQrGlow"
                               Storyboard.TargetProperty="Opacity"
                               From="0.25" To="0.5" Duration="0:0:1.2"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Border.Triggers>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="{Binding ExtendQrImage}" Width="72" Height="72"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Foreground="#FF0D1117"
                     FontFamily="{StaticResource FontChakra}" FontSize="13" FontWeight="SemiBold">
            <Run Text="Scan to extend"/>
            <LineBreak/>
            <Run Text="session"/>
          </TextBlock>
          <TextBlock Foreground="#FF6B7280"
                     FontFamily="{StaticResource FontMono}" FontSize="10" Margin="0,4,0,0">
            <Run Text="Seansni uzaytirish"/>
            <LineBreak/>
            <Run Text="uchun skanerlang"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
