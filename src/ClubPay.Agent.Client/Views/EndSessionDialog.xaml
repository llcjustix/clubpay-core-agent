<Window x:Class="ClubPay.Agent.Client.Views.EndSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={StaticResource Loc}, Path=[EndSession], Mode=OneWay}" SizeToContent="WidthAndHeight" MinWidth="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource BgDark}" Foreground="White">
  <Border Padding="28" BorderBrush="#4700D4FF" BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[EndSession], Mode=OneWay}" FontFamily="{StaticResource FontChakra}"
                 FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[EndSessionVoucherNotice], Mode=OneWay}"
                 Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,18"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{Binding Source={StaticResource Loc}, Path=[Cancel], Mode=OneWay}" Padding="16,8" Margin="0,0,10,0" Click="OnCancel"/>
        <Button Content="{Binding Source={StaticResource Loc}, Path=[EndAndSend], Mode=OneWay}" Padding="16,8" Click="OnConfirm"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
