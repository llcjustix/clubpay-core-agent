<Window x:Class="ClubPay.Agent.Client.Views.SessionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClubPay.Agent.Client.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Width="452" SizeToContent="Height">

  <StackPanel>
    <views:ActiveSessionView DataContext="{Binding ActiveSession}"/>

    <!-- Shown only when a game is running; user taps to return to launcher -->
    <Button x:Name="ReturnBtn"
            Content="← Launcherga qaytish"
            Margin="0,6,0,0"
            Padding="12,8"
            FontFamily="{StaticResource FontMono}"
            FontSize="12"
            Foreground="{StaticResource CyanBrush}"
            Background="#CC0D1117"
            BorderBrush="{StaticResource CyanBrush}"
            BorderThickness="1"
            Cursor="Hand"
            Visibility="Collapsed"
            Click="OnReturnClicked"/>
  </StackPanel>
</Window>
