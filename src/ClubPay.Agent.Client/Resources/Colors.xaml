<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Core palette -->
  <Color x:Key="ColorBgDark">#FF0D1117</Color>
  <Color x:Key="ColorBgMid">#FF161430</Color>
  <Color x:Key="ColorBgCard">#FF1A1A2E</Color>
  <Color x:Key="ColorCyan">#FF00D4FF</Color>
  <Color x:Key="ColorGreen">#FF00FF88</Color>
  <Color x:Key="ColorRed">#FFFF3B5C</Color>
  <Color x:Key="ColorYellow">#FFFFD60A</Color>
  <Color x:Key="ColorOrange">#FFFF9B3C</Color>
  <Color x:Key="ColorTextPrimary">#FFC7CCD6</Color>
  <Color x:Key="ColorTextSecondary">#FFAEB6C2</Color>
  <Color x:Key="ColorTextMuted">#FF7F8694</Color>
  <Color x:Key="ColorTextDimmed">#FF6F7787</Color>
  <Color x:Key="ColorRedSoft">#FFFF8094</Color>
  <Color x:Key="ColorGreenSoft">#FFBDF5D8</Color>
  <Color x:Key="ColorCyanSoft">#FF9FE6FF</Color>

  <!-- Solid brushes -->
  <SolidColorBrush x:Key="BgDark"        Color="{StaticResource ColorBgDark}"/>
  <SolidColorBrush x:Key="BgMid"         Color="{StaticResource ColorBgMid}"/>
  <SolidColorBrush x:Key="BgCard"        Color="{StaticResource ColorBgCard}"/>
  <SolidColorBrush x:Key="CyanBrush"     Color="{StaticResource ColorCyan}"/>
  <SolidColorBrush x:Key="GreenBrush"    Color="{StaticResource ColorGreen}"/>
  <SolidColorBrush x:Key="RedBrush"      Color="{StaticResource ColorRed}"/>
  <SolidColorBrush x:Key="YellowBrush"   Color="{StaticResource ColorYellow}"/>
  <SolidColorBrush x:Key="OrangeBrush"   Color="{StaticResource ColorOrange}"/>
  <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource ColorTextPrimary}"/>
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}"/>
  <SolidColorBrush x:Key="TextMuted"     Color="{StaticResource ColorTextMuted}"/>
  <SolidColorBrush x:Key="TextDimmed"    Color="{StaticResource ColorTextDimmed}"/>
  <SolidColorBrush x:Key="RedSoftBrush"  Color="{StaticResource ColorRedSoft}"/>
  <SolidColorBrush x:Key="Transparent0"  Color="#00FFFFFF"/>

  <!-- Background gradient -->
  <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF0C1020" Offset="0"/>
    <GradientStop Color="#FF161430" Offset="0.55"/>
    <GradientStop Color="#FF0D1117" Offset="1"/>
  </LinearGradientBrush>

  <!-- Logo gradient (cyan → green) -->
  <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF00D4FF" Offset="0"/>
    <GradientStop Color="#FF00FF88" Offset="1"/>
  </LinearGradientBrush>

  <!-- PC-id title gradient (white top → steel bottom) -->
  <LinearGradientBrush x:Key="PcIdGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="White"     Offset="0"/>
    <GradientStop Color="#FF9FB4C9" Offset="1"/>
  </LinearGradientBrush>

  <!-- Freeze red glow overlay -->
  <RadialGradientBrush x:Key="FreezeVignette" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
    <GradientStop Color="#00FF3B5C" Offset="0.4"/>
    <GradientStop Color="#26FF3B5C" Offset="1"/>
  </RadialGradientBrush>

  <!-- Vignette (corners dark) -->
  <RadialGradientBrush x:Key="Vignette" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
    <GradientStop Color="#00000000" Offset="0.5"/>
    <GradientStop Color="#AA000000" Offset="1"/>
  </RadialGradientBrush>

</ResourceDictionary>
