<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters">

  <!-- App-wide converter instances -->
  <cv:BoolToVisibilityConverter    x:Key="BoolVis"/>
  <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
  <cv:InverseBooleanConverter      x:Key="InvBool"/>
  <cv:TimerToBrushConverter        x:Key="TimerBrush"/>

  <!-- Extra brushes referenced in views -->
  <SolidColorBrush x:Key="CyanSoftBrush"  Color="#FF9FE6FF"/>
  <SolidColorBrush x:Key="GreenSoftBrush" Color="#FFBDF5D8"/>

  <!-- Base font families -->
  <FontFamily x:Key="FontChakra">Chakra Petch, Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>

  <!-- Zone badge style -->
  <Style x:Key="ZoneBadge" TargetType="Border">
    <Setter Property="CornerRadius"   Value="999"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="18,6"/>
  </Style>

  <!-- Status pill style -->
  <Style x:Key="StatusPill" TargetType="Border">
    <Setter Property="CornerRadius"   Value="999"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="14,8"/>
  </Style>

  <!-- Dark card -->
  <Style x:Key="DarkCard" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="22"/>
  </Style>

  <!-- Section label -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily"  Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize"    Value="14"/>
    <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
  </Style>

  <!-- Muted mono label -->
  <Style x:Key="MonoLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize"   Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  </Style>

  <!-- Action button base -->
  <Style x:Key="ActionBtn" TargetType="Border">
    <Setter Property="CornerRadius"    Value="13"/>
    <Setter Property="Background"      Value="#0DFFFFFF"/>
    <Setter Property="BorderBrush"     Value="#1EFFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="15,0"/>
    <Setter Property="Height"          Value="56"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>

  <!-- Action button text -->
  <Style x:Key="ActionBtnText" TargetType="TextBlock">
    <Setter Property="FontFamily"  Value="{StaticResource FontChakra}"/>
    <Setter Property="FontSize"    Value="19"/>
    <Setter Property="FontWeight"  Value="SemiBold"/>
    <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment"   Value="Center"/>
  </Style>

</ResourceDictionary>
