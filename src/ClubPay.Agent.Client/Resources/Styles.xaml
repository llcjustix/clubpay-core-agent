<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:ClubPay.Agent.Client.Converters">

  <!-- App-wide converter instances -->
  <cv:BoolToVisibilityConverter    x:Key="BoolVis"/>
  <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
  <cv:TimerToBrushConverter        x:Key="TimerBrushGlobal"/>
  <cv:TiyinToSomConverter          x:Key="TiyinSom"/>

  <!-- Extra brushes referenced in views -->
  <SolidColorBrush x:Key="CyanSoftBrush"  Color="#FF9FE6FF"/>
  <SolidColorBrush x:Key="GreenSoftBrush" Color="#FFBDF5D8"/>

  <!-- Base font families -->
  <FontFamily x:Key="FontChakra">Chakra Petch, Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>

  <!-- Compact, dark language selector.  This replaces the native Windows combo,
       whose white dropdown looked like a foreign control on the player shell. -->
  <Style x:Key="LanguagePickerItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="#2600D4FF"/>
        <Setter Property="Foreground" Value="White"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#1800D4FF"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LanguagePicker" TargetType="ComboBox">
    <Setter Property="Width" Value="76"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="#FF121925"/>
    <Setter Property="BorderBrush" Value="#4D00D4FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource LanguagePickerItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <ToggleButton Name="PickerToggle"
                          Focusable="False"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="PickerBorder"
                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          CornerRadius="8">
                    <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                      </Grid.ColumnDefinitions>
                      <ContentPresenter VerticalAlignment="Center"
                                        TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                      <Path Grid.Column="1" Data="M0,0 L8,0 L4,4 Z" Fill="#FF77DFF5"
                            Width="8" Height="4" Stretch="Fill" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#AA00D4FF"/>
                      <Setter TargetName="PickerBorder" Property="Background" Value="#FF172334"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#FF00D4FF"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="PickerBorder" Property="Opacity" Value="0.45"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
              <Border Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}"
                      Background="#FF101722" BorderBrush="#6600D4FF" BorderThickness="1" CornerRadius="8"
                      SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <ScrollViewer Margin="3" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Zone badge style -->
  <Style x:Key="ZoneBadge" TargetType="Border">
    <Setter Property="CornerRadius"   Value="999"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="18,6"/>
  </Style>

  <!-- Status pill style -->
  <Style x:Key="StatusPill" TargetType="Border">
    <Setter Property="CornerRadius"   Value="999"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="14,8"/>
  </Style>

  <!-- Dark card -->
  <Style x:Key="DarkCard" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F71A1A2E" Offset="0"/>
          <GradientStop Color="#F70D1117" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="22"/>
  </Style>

  <!-- Section label -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily"  Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize"    Value="14"/>
    <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
  </Style>

  <!-- Muted mono label -->
  <Style x:Key="MonoLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize"   Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  </Style>

  <!-- Action button base -->
  <Style x:Key="ActionBtn" TargetType="Border">
    <Setter Property="CornerRadius"    Value="13"/>
    <Setter Property="Background"      Value="#0DFFFFFF"/>
    <Setter Property="BorderBrush"     Value="#1EFFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="15,0"/>
    <Setter Property="Height"          Value="56"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>

  <!-- Action button text -->
  <Style x:Key="ActionBtnText" TargetType="TextBlock">
    <Setter Property="FontFamily"  Value="{StaticResource FontChakra}"/>
    <Setter Property="FontSize"    Value="19"/>
    <Setter Property="FontWeight"  Value="SemiBold"/>
    <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment"   Value="Center"/>
  </Style>

</ResourceDictionary>
